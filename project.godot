; Dragon Awakening - Godot 4 project skeleton
; Initial architecture only. Gameplay systems are intentionally empty.

config_version=5

[application]
config/name="Dragon Awakening"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
GameManager="*res://scripts/core/game_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
